<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="NewNavigationRequest">
      <ClearNavigationPath path="{path}"/>
      <RecoveryNode number_of_retries="3" name="NavigateRecovery">
        <PipelineSequence name="FollowRetainedPath">
          <!-- Check at 1 Hz; compute only when the retained path is unusable. -->
          <RateController hz="1.0">
            <Sequence>
              <Fallback name="CheckMapForCurrentGoal">
                <Inverter><PathGoalUnchanged path="{path}"/></Inverter>
                <ReadPathValidity path="{path}" valid="{retained_valid}"/>
              </Fallback>
              <Fallback name="ReuseOrPlan">
                <ReactiveSequence>
                  <PathGoalUnchanged path="{path}"/>
                  <KeepCheckedPath valid="{retained_valid}" path="{path}"/>
                </ReactiveSequence>
                <Sequence>
                  <RememberPathGoal/>
                  <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
                </Sequence>
              </Fallback>
            </Sequence>
          </RateController>
          <FollowCheckedPath path="{path}">
            <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
          </FollowCheckedPath>
        </PipelineSequence>
        <ReactiveFallback name="RetryRetainedPath">
          <GoalUpdated/>
          <Wait wait_duration="1"/>
        </ReactiveFallback>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
