<?xml version="1.0"?>
<package format="3">
  <name>ranger_nav_plugins</name><version>0.1.0</version>
  <description>Simulation navigation constraints for Ranger parallel and steering modes.</description>
  <maintainer email="maintainer@example.org">Ranger simulation project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>dwb_core</depend><depend>pluginlib</depend>
  <depend>dwb_critics</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>xtensor</depend><depend>xsimd</depend>
  <depend condition="$ROS_DISTRO != 'jazzy'">behaviortree_cpp_v3</depend>
  <depend condition="$ROS_DISTRO == 'jazzy'">behaviortree_cpp</depend>
  <depend>geometry_msgs</depend><depend>nav_msgs</depend><depend>nav2_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_costmap_2d</depend><depend>nav2_core</depend>
  <depend>nav2_smac_planner</depend><depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>nav2_behavior_tree</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
