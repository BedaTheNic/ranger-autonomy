# Replace with your Docker Hub / GHCR / private registry image and release tag.
AUTONOMY_IMAGE=ghcr.io/bedathenic/ranger-autonomy:jazzy-r3
# Must match the existing robot driver container. Inspect its environment.
ROS_DOMAIN_ID=9
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Reach the existing host-network driver container without sharing its private IPC.
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
LOCALIZATION_MODE=mapping
NAV_PROFILE=adaptive
STEERING_FEEDBACK_TOPIC=/joint_states
MAP_FILE=/maps/map.yaml
# Existing robot: /scan for SLAM, /scan_obstacles for near-field obstacle detection.
OBSTACLE_SCAN_TOPIC=/scan_obstacles
LOCALIZATION_SCAN_TOPIC=/scan
# Optional converter has its own output to avoid duplicate /scan publishers.
ADAPTER_SCAN_TOPIC=/autonomy/scan
RANGER_LOG_MAX_BYTES=20971520
RANGER_LOG_SAMPLE_HZ=5
