Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 35; 40; 45
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 95; 105; 115
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.85
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/TF
      Name: Robot pose
      Enabled: true
      Marker Scale: 0.4
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: false
        ranger_base_link:
          Value: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Ranger pose
      Enabled: true
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape: Arrow
      Arrow:
        Color: 255; 80; 80
        Shaft Length: 0.3
        Shaft Radius: 0.035
        Head Length: 0.15
        Head Radius: 0.09
      Covariance:
        Value: false
      Topic:
        Value: /odom
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Obstacles
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 160; 60
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Points
      Topic:
        Value: /scan_obstacles
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Robot footprint
      Enabled: true
      Color: 90; 220; 170
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Preview path
      Enabled: true
      Color: 80; 210; 255
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Value: /autonomy/preview_path
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /autonomy/preview_goal
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: ranger_base_link
      Scale: 65
      Angle: 0
      X: 0
      Y: 0
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1260
  Height: 760
  X: 0
  Y: 0
